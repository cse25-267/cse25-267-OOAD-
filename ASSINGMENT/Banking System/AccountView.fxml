<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AccountController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Open account" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Customer" />
            <ComboBox fx:id="customerCombo" onAction="#onCustomerSelected" onShowing="#onCustomersShowing" prefWidth="260.0" />
            <Label text="Account type" />
            <ComboBox fx:id="typeCombo" onAction="#onTypeChanged" prefWidth="130.0" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Account no." />
            <TextField fx:id="accountNumberField" prefWidth="110.0" promptText="e.g. SA002" />
            <Label text="Opening balance (P)" />
            <TextField fx:id="openingBalanceField" prefWidth="110.0" />
            <Label text="Branch" />
            <TextField fx:id="branchField" prefWidth="160.0" />
         </children>
      </HBox>
      <HBox fx:id="chequeBox" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Employer name" />
            <TextField fx:id="employerNameField" prefWidth="180.0" />
            <Label text="Employer address" />
            <TextField fx:id="employerAddressField" prefWidth="220.0" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <Button onAction="#onOpenAccount" text="Open account" />
            <Button onAction="#onRefresh" text="Refresh" />
         </children>
      </HBox>
      <Separator />
      <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Accounts of selected customer" />
      <TableView fx:id="accountsTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="typeCol" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="numberCol" prefWidth="140.0" text="Account no." />
            <TableColumn fx:id="branchCol" prefWidth="200.0" text="Branch" />
            <TableColumn fx:id="balanceCol" prefWidth="140.0" text="Balance" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
