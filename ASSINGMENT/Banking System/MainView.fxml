<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="920.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <Label style="-fx-font-size: 22; -fx-font-weight: bold;" text="Banking System" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
      </Label>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="Customers">
               <content>
                  <fx:include source="CustomerView.fxml" />
               </content>
            </Tab>
            <Tab text="Accounts">
               <content>
                  <fx:include source="AccountView.fxml" />
               </content>
            </Tab>
            <Tab text="Transactions">
               <content>
                  <fx:include source="TransactionView.fxml" />
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
