<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TransactionController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Transactions" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Customer" />
            <ComboBox fx:id="customerCombo" onAction="#onCustomerSelected" onShowing="#onCustomersShowing" prefWidth="260.0" />
            <Label text="Account" />
            <ComboBox fx:id="accountCombo" onAction="#onAccountSelected" onShowing="#onAccountsShowing" prefWidth="220.0" />
         </children>
      </HBox>
      <Label fx:id="balanceLabel" style="-fx-font-size: 16; -fx-font-weight: bold;" text="Balance: -" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Amount (P)" />
            <TextField fx:id="amountField" prefWidth="120.0" />
            <Button onAction="#onDeposit" text="Deposit" />
            <Button onAction="#onWithdraw" text="Withdraw" />
            <Button onAction="#onCalculateInterest" text="Calculate interest" />
         </children>
      </HBox>
      <Separator />
      <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Transaction history" />
      <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="idCol" prefWidth="160.0" text="Transaction ID" />
            <TableColumn fx:id="dateCol" prefWidth="140.0" text="Date" />
            <TableColumn fx:id="typeCol" prefWidth="140.0" text="Type" />
            <TableColumn fx:id="amountCol" prefWidth="140.0" text="Amount" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
